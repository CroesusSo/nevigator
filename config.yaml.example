proxy:
  http_listen: 0.0.0.0:8080
  socks5_listen: 0.0.0.0:1080
  admin_listen: 127.0.0.1:9090
  pac_path: /etc/proxy.pac
  # tun_device: removed - TUN routing no longer supported
  default_external_proxy: ""
  external_proxies: []
  # Inbound SOCKS5 authentication. When username/password are set, clients must
  # authenticate (RFC 1929) and no-auth is refused. Omit for open no-auth access.
  # socks5_auth:
  #   username: "user"
  #   password: "pass"
  # Bounds greeting + auth + CONNECT handling so idle clients cannot pin a
  # goroutine. Defaults to 10s when unset.
  # socks5_handshake_timeout: 10s
  # TCP keepalive probes on accepted client connections and outbound dials.
  # Idle/Interval/Count default to 15s/5s/3 (~30s to detect a dead peer) when
  # enabled but unset. Detection takes roughly idle + interval*count.
  # Disabled by default; the relay path is an opaque tunnel, so this is the only
  # way to keep idle client connections warm.
  # tcp_keepalive:
  #   enabled: true
  #   idle: 15s
  #   interval: 5s
  #   count: 3
  tls:
    certificate_file: ""
    key_file: ""
    ca_file: ""
    min_version: 0
    max_version: 0
    cipher_suites: []
    prefer_server_cipher_suites: false
    session_tickets_disabled: false
    client_auth: ""
    client_cas: ""
    insecure_skip_verify: false
    timeout: 0s

pac:
  local_ip: ""
  dns_timeout: 500ms
  eval_timeout: 200ms
  enable_dns_cache: false
  enable_url_glob: false
  dns_max_entries: 100
  dns_ttl: 5m
  cache_enabled: false
  cache_max_size: 10000
  cache_ttl: 10m

gfw:
  disabled: false
  # The list is fetched through this proxy's own SOCKS5 listener, so it
  # follows the same routing rules as any other client and leaves through the
  # configured upstream. The source host is pinned to that route until a rule
  # for it exists, so the first fetch does not go out directly.
  source_url: "https://raw.githubusercontent.com/gfwlist/gfwlist/master/gfwlist.txt"
  local_rules_path: "/etc/proxy-pac/gfw-rules.json"
  user_rules_path: "/etc/proxy-pac/user-rules.json"
  update_interval: 24h
  fetch_on_startup: true
  http_timeout: 60s
  # DNS servers used to resolve host names for direct connections. They are
  # authoritative: a name they do not know is not retried against the system
  # resolver.
  custom_dns_servers: []

# Example external proxy configurations (uncomment and customize).
# The SSH keepalive block drives keepalive@openssh.com requests; its optional
# tcp sub-block tunes socket-level probes independently. Omit tcp to keep the
# previous 30s idle default.
# external_proxies:
#   - id: "ssh-us"
#     kind: "ssh"
#     address: "user@ssh.example.com:22"
#     auth_method: "password"
#     password: "your_password"
#     keepalive:
#       enabled: true
#       interval: 30s
#       tcp:
#         enabled: true
#         idle: 15s
#         interval: 5s
#         count: 3
#   - id: "socks5-tw"
#     kind: "socks5"
#     address: "socks5.example.com:1080"
#     username: "user"
#     password: "pass"
