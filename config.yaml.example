proxy:
  http_listen: 0.0.0.0:8080
  socks5_listen: 0.0.0.0:1080
  admin_listen: 127.0.0.1:9090
  pac_path: /etc/proxy.pac
  tun_device: tun0
   default_external_proxy: ""  # optional, ID from external_proxies
   # Example external proxy configurations (uncomment and customize):
   # external_proxies:
   #   - id: "ssh-us"
   #     kind: "ssh"
   #     address: "user@ssh.example.com:22"
   #     auth_method: "password"
   #     password: "your_password"
   #     keepalive:
   #       enabled: true
   #       interval: 30s
   #   - id: "socks5-tw"
   #     kind: "socks5"
   #     address: "socks5.example.com:1080"
   #     username: "user"
   #     password: "pass"
   external_proxies: []        # list of external SOCKS5/SSH proxies

pac:
  local_ip: ""            # auto-discovered from tun0
  enable_url_glob: false   # set true to preserve URL-glob rules (not recommended; native engine does not support URL-glob)
  dns_timeout: 500ms
  eval_timeout: 200ms
  enable_dns_cache: true

gfw:
  source_url: "https://github.com/gfwlist/gfwlist/raw/refs/heads/master/gfwlist.txt"
  local_rules_path: "/etc/proxy-pac/gfw-rules.json"
  user_rules_path: "/etc/proxy-pac/user-rules.json"
  update_interval: 24h
  fetch_on_startup: true
  http_timeout: 30s
